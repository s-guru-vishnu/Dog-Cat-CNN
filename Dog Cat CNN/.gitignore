# Python virtual environments
.venv/
venv/
env/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Dataset files & archives (Do not commit full datasets)
data/
*.zip
*.tar.gz

# Model weights & temporary files
*.h5
*.keras
models/*.keras
!models/.gitkeep

# Results & outputs
results/*.png
results/*.json
!results/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
*.swp
